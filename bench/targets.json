  "docker_targets_roadmap": [
    "bludit-3.16.2 (CVE-2026-4420-shape stored XSS, expect 1 executable)",
    "dvwa-latest (5 XSS variants across low/med/high)",
    "juice-shop-latest (8 XSS challenges)",
    "webgoat-8.2 (3 XSS lessons)",
    "own-hardened: hotel-platform, wallet-api, mahrem (expect 0 XSS)",
    "prestashop-8.1 (recent stored XSS module CVEs)",
    "opencart-4.0 (2024 stored XSS CVEs)",
    "cockpit-cms-2.5 (admin panel XSS)",
